{
  "name": "footy-academy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @footy-academy/game dev",
    "dev:landing": "pnpm --filter @footy-academy/landing dev",
    "build": "pnpm --filter @footy-academy/game build",
    "build:landing": "pnpm --filter @footy-academy/landing build",
    "build:all": "pnpm -r build",
    "lint": "pnpm --filter @footy-academy/game lint",
    "format": "pnpm --filter @footy-academy/game format",
    "format:check": "pnpm --filter @footy-academy/game format:check"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  }
}
